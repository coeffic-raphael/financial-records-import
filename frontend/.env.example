# The ONLY variable this frontend may carry.
#
# Every VITE_* value is compiled into the JavaScript bundle sent to the browser
# and is readable by anyone in DevTools. That is publication, not configuration,
# so no provider key, no secret and no token belongs here. Extraction happens
# server-side; the frontend does not even know which provider is used.
VITE_API_BASE_URL=http://localhost:8000
