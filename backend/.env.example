# Copy to .env and fill in. The .env file is NEVER committed.

# --- Database ---
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/financial_records

# --- AI extraction ---
# None of these may carry the VITE_ prefix: any VITE_* variable is compiled into
# the JavaScript bundle sent to the browser and is therefore public. Extraction
# is server-side only; the frontend never learns which provider is used.
#
# gemini | openai | mock
#
# Defaults to "mock" so that `cp .env.example .env && make run` starts with no
# credentials at all: the mock provider returns canned records, which is enough
# to exercise the whole workflow. Switch to "gemini" once a key is filled in
# below -- the application refuses to start on a provider it cannot use, rather
# than failing on someone's first upload.
EXTRACTION_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# When both keys are present the primary provider is chained to the other, so a
# transient failure falls through instead of failing the extraction.
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5.6
EXTRACTION_TIMEOUT_SECONDS=180

# Records below this confidence are stored as NEEDS_REVIEW even when no field
# is invalid.
EXTRACTION_CONFIDENCE_THRESHOLD=0.70

# Provider quotas are counted in requests per minute, so the slowest component
# sets the pace rather than the thread pool.
MAX_CONCURRENT_EXTRACTIONS=3

MAX_UPLOAD_BYTES=10485760

# --- Authentication ---
# REQUIRED, at least 32 characters. The application refuses to start otherwise
# rather than signing tokens with a weak key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty on purpose: DEBUG below generates an ephemeral one so that copying
# this file is enough to start locally. Set a real value for anything else.
JWT_SECRET=

# Short-lived on purpose: it is what makes an access-token denylist
# unnecessary. Revocation happens on the refresh token, which is stateful.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# A Secure cookie is never sent over http://localhost, so sign-in would fail
# locally with nothing to show for it. Keep false in local development ONLY.
COOKIE_SECURE=false

# Generates an ephemeral signing secret when JWT_SECRET is empty, so that
# `cp .env.example .env && make run` works with no further step. Every session
# is invalidated on restart, which is fine locally and unacceptable anywhere
# else -- hence the guard that makes an empty secret fatal outside debug.
DEBUG=true

# --- CORS ---
# Explicit origins are mandatory: browsers forbid "*" together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
