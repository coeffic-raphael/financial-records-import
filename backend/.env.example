# Copy to .env and fill in. The .env file is NEVER committed.

# --- Database ---
DATABASE_URL=sqlite:///./financial_records.db

# --- AI provider ---
# None of these may carry the VITE_ prefix: any VITE_* variable is compiled
# into the JavaScript bundle sent to the browser and is therefore public.
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EXTRACTION_CONFIDENCE_THRESHOLD=0.70
MAX_CONCURRENT_EXTRACTIONS=3

# --- Authentication ---
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Secure cookies are not sent over http://localhost; keep false in local dev only.
COOKIE_SECURE=false

# --- CORS ---
# Explicit origins are mandatory: browsers forbid "*" together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
